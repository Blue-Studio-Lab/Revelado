# Revelado engine configuration. Copy to engine/.env (gitignored) and edit. Everything is optional.

# Where the engine keeps its catalog, thumbnails, models and developed results. Default: <repo>/cache
REVELADO_CACHE_DIR=

# Folder with your own film scans: <REVELADO_FILMS_DIR>/<stock_id>/scans/*.tif (shown in the film picker)
REVELADO_FILMS_DIR=

# Extra folders exports may be written into, separated by ':' (';' on Windows). Home, temp, shared folders,
# external/network disks (/Volumes, /media, /mnt, /run/user/<uid>, /srv, /data, Windows drives and \\server\share)
# are allowed by default; the MCP server's REVELADO_EXPORT_DIRS is honoured too.
REVELADO_EXPORT_ROOTS=

# External tools, only if they are not on PATH / in the usual install folder
REVELADO_RAWTHERAPEE_CLI=
REVELADO_EXIFTOOL=

# Face detection backend: auto | vision (macOS) | yunet | haar.  REVELADO_OFFLINE=1 disables model downloads.
REVELADO_FACE_BACKEND=auto

# Bit-reproducible develops (default 1). 0 = rawtherapee-cli multithreaded: faster, tiny run-to-run differences.
REVELADO_DETERMINISTIC=1

# Anthropic API key for "Deja que Claude elija" (culling). Optional; never logged.
ANTHROPIC_API_KEY=

# Bind address/port (defaults 127.0.0.1:8790). Dev mode also accepts the token "dev".
REVELADO_HOST=127.0.0.1
REVELADO_PORT=8790
REVELADO_DEV=1

# Memory guard for the develop process tree (GB of RSS before it is killed)
REVELADO_HEAVY_RSS_CAP_GB=9
# Minimum available RAM (GB) before a develop job is admitted
REVELADO_HEAVY_MIN_AVAILABLE_GB=3.5
# Minimum free disk (GB) in the cache volume before a develop job is admitted
REVELADO_MIN_FREE_DISK_GB=6

# Maintainers only: compare against a private reference engine (never needed by the app)
# REVELADO_DEVELOP_ENGINE=legacy
# REVELADO_LEGACY_ENGINE_DIR=
# REVELADO_LEGACY_PYTHON=
